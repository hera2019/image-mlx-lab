+    const sh: u32 = @intCast(h);
+    if (sw == 0 or sh == 0) return error.ImageDecodeFailed;
+    if (W % 32 != 0 or H % 32 != 0) return error.InvalidImageDimensions;
+    const source_plane: usize = @as(usize, sw) * sh;
+    const rgba = src[0 .. source_plane * 4];
